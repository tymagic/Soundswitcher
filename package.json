{
  "name": "sound-switcher",
  "version": "1.0.0",
  "description": "一键切换耳机和麦克风的桌面应用 - 液态玻璃风格",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.soundswitcher.app",
    "productName": "Sound Switcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "scripts/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "scripts/**/*",
      "assets/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "icon": "assets/icon.png"
    }
  }
}
